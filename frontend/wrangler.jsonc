{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecofusion-rentalcars2-0",
  "compatibility_date": "2026-09-15",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker/index.js",
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ADMIN_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ADMIN_IP_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
