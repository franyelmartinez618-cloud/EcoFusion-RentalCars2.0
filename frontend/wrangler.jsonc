{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecofusion-rentalcars2-0",
  "compatibility_date": "2026-09-15",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker/index.js"
}
