ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_TTL_SECONDS=28800
# XAMPP MySQL (recommended): create the database first, then set this value.
MYSQL_URL=mysql+pymysql://root:@127.0.0.1:3306/ecofusion
# Admin username/password are provisioned locally with: python setup_admin.py
ADMIN_SESSION_TTL_SECONDS=3600
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
PERSONA_API_KEY=
PERSONA_INQUIRY_TEMPLATE_ID=
PERSONA_WEBHOOK_SECRET=

# Set true only after configuring Firebase App Check with reCAPTCHA Enterprise
FIREBASE_APPCHECK_REQUIRED=false

# Optional transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
